<Window x:Class="ParnerDiscount.EditPartnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParnerDiscount"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/Мастер пол.ico"
        WindowState="Maximized"
        Title="Редактирование партнёра" Height="600" Width="1200">
    <StackPanel Orientation="Vertical" Margin="10">
        <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Center">
        <Image Source="/Images/Мастер пол.png" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
        <TextBlock Text="Редактирование партнёра" FontSize="20"></TextBlock>
    </StackPanel>

        <TextBlock Text="Наименование" Margin="10"/>
        <TextBox Name="NameBox"/>

        <TextBlock Text="Рейтинг" Margin="10"/>
        <TextBox Name="RaitingBox"/>

        <TextBlock Text="Почта" Margin="10"/>
        <TextBox Name="EmailBox"/>

        <TextBlock Text="Номер телефона" Margin="10"/>
        <TextBox Name="PhoneNumberBox"/>

        <TextBlock Text="Адрес" Margin="10"/>
        <TextBox Name="AddressBox"/>

        <TextBlock Text="Директор" Margin="10"/>
        <TextBox Name="DirectorBox"/>

        <TextBlock Text="ИНН" Margin="10"/>
        <TextBox Name="INNBox"/>

        <TextBlock Text="Тип партнёра" Margin="10"/>
        <ComboBox Name="PartnerTypeBox">
            <ComboBoxItem Content="ЗАО"/>
            <ComboBoxItem Content="ООО"/>
            <ComboBoxItem Content="ПАО"/>
            <ComboBoxItem Content="ОАО"/>
        </ComboBox>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Background="#67BA80" Content="Сохранить" Width="120" 
            Name="SaveButton" Click="SaveButton_Click"
                    Height="30" FontSize="15"
            HorizontalAlignment="Right" Grid.Column="1" />

            <Button Background="#67BA80" Content="Назад" Width="140" 
            Name="CancelButton" Click="CancelButton_Click"
                      Height="30" FontSize="15"
            HorizontalAlignment="Left" Grid.Column="0" >
            </Button>
            
        </Grid>



    </StackPanel>
</Window>
