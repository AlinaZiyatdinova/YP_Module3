<Window x:Class="ParnerDiscount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParnerDiscount"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/Мастер пол.ico"
        WindowState="Maximized"
        Title="Список парнеров" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Key="PartnerCardTemplate">
            <Border BorderBrush="Black"  Background="#F4E8D3" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="16" >
                            <Run Text="{Binding PatrnerType}"></Run>
                            <Run Text="|"></Run>
                            <Run Text="{Binding Name}"></Run>
                        </TextBlock>
                        <TextBlock Text="{Binding Director}" />
                        <TextBlock Text="{Binding PhoneNumber, StringFormat={}+{0}}" />
                        <TextBlock>
                            <Run Text="Рейтинг: " />
                            <Run Text="{Binding Raitning}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1"  VerticalAlignment="Top" FontSize="16" Margin="10 0 0 0"
                               Text="{Binding Discount, StringFormat={}{0}%}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Margin="10">
            <Image Source="/Images/Мастер пол.png" Height="40" HorizontalAlignment="Left" Margin="10"/>
            <TextBlock Text="Список парнёров" FontSize="20" VerticalAlignment="Center"  ></TextBlock>
        </StackPanel>
        <StackPanel>
            <ListView Focusable="False" Height="600" SelectionChanged="ButtonEdit_Click" HorizontalContentAlignment="Stretch" x:Name="PartnerListView" ItemsSource="{Binding partners}" ItemTemplate="{StaticResource PartnerCardTemplate}" 
                  Background="Transparent" BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
            <Button Background="#67BA80" Content="Добавить партнёра" Margin="10"
                 Name="AddPartnerButton" 
                    Click="AddPartnerButton_Click"
                    Height="30" FontSize="15"
                 HorizontalAlignment="Right" Grid.Column="0" >
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
